<Window
    x:Class="OTP_Client_WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OTP_Client_WinUI3"
    Title="OTP-Client-WinUI3"
    >
    <StackPanel Margin="20" VerticalAlignment="Top">
        <!-- 顶部按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button x:Name="AddOtpButton" Content="添加" Width="80" Margin="0,0,10,0" Click="AddOTPClickHandler"/>
            <Button x:Name="ManageClockButton" Content="网络时钟服务器管理" Width="150"/>
        </StackPanel>

        <!-- OTP 列表 -->
        <ListBox x:Name="OtpListBox" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,0,0,8" BorderThickness="1" BorderBrush="Gray">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Width="200">
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Secret}" FontSize="12"/>
                            </StackPanel>
                            <ProgressBar Width="100" Height="16" Value="{Binding Progress}" Maximum="100" Margin="10,0"/>
                            <TextBlock Text="{Binding RemainingTimeText}" Width="60" Margin="10,0"/>
                            <Button Content="编辑" Width="50" Margin="10,0"/>
                            <Button Content="删除" Width="50" Margin="10,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ContentDialog x:Name="OTPDialog"
    Title="编辑/添加OTP" Height="400" Width="400">
            <StackPanel Margin="20">
                <TextBlock Text="令牌名称"/>
                <TextBox x:Name="FriendlyNameBox" Margin="0,0,0,10"/>
                <TextBlock Text="令牌密钥"/>
                <TextBox x:Name="SecretBox" Margin="0,0,0,10"/>
                <CheckBox x:Name="IsHotpBox" Content="密码是计数的" Margin="0,0,0,10"/>
                <Button x:Name="AdvancedOptionsButton" Content="高级选项 >> " Margin="0,0,0,10" Click="AdvancedOptionsButton_Click"/>
                <StackPanel x:Name="AdvancedOptionsPanel" Visibility="Collapsed">
                    <TextBlock Text="OTP密钥长度"/>
                    <TextBox x:Name="SecretLengthBox" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" x:Name="Interval">
                        <TextBlock Text="时间间隔"/>
                        <TextBox x:Name="TotpStepBox"  Margin="10,0,0,0" Text="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" x:Name="">
                        <TextBlock Text="计数器"/>
                        <TextBox x:Name="HotpCounterBox" Width="60" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="密钥编码格式"/>
                    <ComboBox x:Name="EncodingBox" Margin="0,0,0,10">
                        <ComboBoxItem Content="Base32"/>
                        <ComboBoxItem Content="Base64"/>
                        <ComboBoxItem Content="Hex"/>
                    </ComboBox>
                    <TextBlock Text="OTP算法"/>
                    <ComboBox x:Name="AlgorithmBox" Margin="0,0,0,10">
                        <ComboBoxItem Content="SHA1"/>
                        <ComboBoxItem Content="SHA256"/>
                        <ComboBoxItem Content="SHA512"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="确定" Width="80" Margin="0,0,10,0"/>
                    <Button Content="取消" Width="80"/>
                </StackPanel>
            </StackPanel>
        </ContentDialog>
        <ContentDialog x:Name="SNTPDialog"
    Title="时钟管理" Height="300" Width="350">
            <StackPanel Margin="20">
                <CheckBox x:Name="ForceNetworkClockBox" Content="强制使用网络时钟" Margin="0,0,0,10"/>
                <TextBlock Text="时钟服务器1"/>
                <TextBox x:Name="ClockServer1Box" Margin="0,0,0,10"/>
                <TextBlock Text="时钟服务器2"/>
                <TextBox x:Name="ClockServer2Box" Margin="0,0,0,10"/>
                <TextBlock Text="同步状态" Margin="0,10,0,0"/>
                <TextBlock x:Name="SyncStatusText" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="确定" Width="80" Margin="0,0,10,0"/>
                    <Button Content="取消" Width="80"/>
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </StackPanel>
</Window>

